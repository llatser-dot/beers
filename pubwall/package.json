    "deploy": "wrangler deploy",
    "schema": "wrangler d1 execute beers-pubwall --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "5.9.3",
    "wrangler": "^4.50.0"
  }
}
