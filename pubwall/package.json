{
  "name": "beers-pubwall",
  "version": "1.0.0",
  "private": true,
  "description": "Beers Pub Wall API — opt-in leaderboard that never receives transcripts or audio; see README/schema for its full metadata boundary.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
